# Copy to .env and edit. .env is gitignored and must never be committed.

# development | staging | production | test
ENVIRONMENT=development

# --- flight data ---------------------------------------------------------
# "fake" serves scripted scenarios from app/providers/fixtures/scenarios.json.
# It needs no key, no network and no subscription, and the whole system works
# with it -- which is why it is the default.
#
# "iaa" is the Ben Gurion board, published by the state on data.gov.il. No key,
# no quota. It is authoritative for Tel Aviv -- cancellations included, which
# the commercial feed drops -- but each record covers only the movement AT Ben
# Gurion, so it knows a departure's time and not the landing three hours later.
#
# Sources can be chained with "+", asked left to right until one has the flight:
#   aerodatabox+iaa   both ends of the journey when available, the board as a
#                     safety net for flights the feed does not carry. Costs a
#                     unit per check.
#   iaa+aerodatabox   free for anything touching Israel, falling back to the
#                     paid feed. Cheaper, but an EU-law claim on an Israeli
#                     departure may go to review for want of a landing time.
FLIGHT_PROVIDER=fake

# For FLIGHT_PROVIDER=aerodatabox. Get one at:
#   https://rapidapi.com/aedbx-aedbx/api/aerodatabox   (free Basic tier)
# A valid RapidAPI key still needs a subscription to this specific API;
# without one every request returns 401.
AERODATABOX_API_KEY=

# --- secrets -------------------------------------------------------------
# Encrypts passengers' national identity numbers at rest, so the database file
# is worthless to anyone who obtains it. The application refuses to read or
# write an ID without this, deliberately: a plaintext fallback is how sensitive
# data reaches production unencrypted and nobody notices for a year.
#
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP SOMEWHERE THE DATABASE IS NOT. Lose it and the ID numbers are
# gone -- that is the design working, and it is still a bad afternoon.
#
# To rotate: put the new key FIRST, keep the old one after it, re-encrypt, then
# drop the old one. The first key encrypts; every key can decrypt.
#   ENCRYPTION_KEYS=<new>,<old>
ENCRYPTION_KEYS=

# --- storage -------------------------------------------------------------
DATABASE_URL=sqlite:///./flight_system.db
UPLOAD_DIR=storage/uploads

# --- the frontend --------------------------------------------------------
# JSON array. Explicit origins, never "*".
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3111","http://127.0.0.1:3111"]

# --- email ---------------------------------------------------------------
# "console" writes messages to the log instead of sending them. It needs no
# account and cannot email a real person by accident, which is why it is the
# default and why it stays the right choice for development.
EMAIL_SENDER=console
EMAIL_FROM=Skyclaim <noreply@example.com>

# For EMAIL_SENDER=smtp. Any provider works -- Postmark, SES, SendGrid,
# Mailgun, Resend, your own Postfix -- because they all speak SMTP.
#   Postmark:  smtp.postmarkapp.com : 587
#   SES:       email-smtp.<region>.amazonaws.com : 587
#   Gmail:     smtp.gmail.com : 587  (needs an app password, not your password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Where links in emails point. A background task has no request to read this
# from, and behind a proxy the request's host is the proxy's anyway.
PUBLIC_BASE_URL=http://localhost:3111

# --- the admin API -------------------------------------------------------
# Empty means the admin API is CLOSED. It lists every customer's name, email
# and national ID, so it fails closed rather than open.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

LOG_LEVEL=INFO

# The readable request trace: input, the API call, what came back, what it was
# normalised to, each law's answer, the decision, and every database write.
# Ignored when ENVIRONMENT=production -- it prints flight details and masked
# customer emails on every request, which is right on a laptop and wrong in a
# log aggregator.
LOG_FLOW=true
